@Oro         = LabelStyle(FontSize: 13, TextColor: #FFD700, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center);
@Plata       = LabelStyle(FontSize: 13, TextColor: #C0C0C0, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center);
@Bronce      = LabelStyle(FontSize: 13, TextColor: #CD7F32, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center);
@Ok          = LabelStyle(FontSize: 11, TextColor: #17CF73, RenderBold: true, RenderUppercase: true, LetterSpacing: 0.5, HorizontalAlignment: Center, VerticalAlignment: Center);
