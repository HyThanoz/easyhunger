  Hovered: (Background: (Color: #3A2030), LabelStyle: (FontSize: 11, TextColor: #F6F7F9, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Pressed: (Background: (Color: #18222F), LabelStyle: (FontSize: 11, TextColor: #F04251, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Sounds: $C.@ButtonSounds
);
@OptBtn = TextButtonStyle(
  Default: (Background: (Color: #202B3C), LabelStyle: (FontSize: 13, TextColor: #F6F7F9, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Hovered: (Background: (Color: #2B384D), LabelStyle: (FontSize: 13, TextColor: #FFC233, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Pressed: (Background: (Color: #18222F), LabelStyle: (FontSize: 13, TextColor: #F6F7F9, HorizontalAlignment: Center, VerticalAlignment: Center)),
