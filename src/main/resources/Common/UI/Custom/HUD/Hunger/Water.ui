// HUD de sed - diseno "Runa" de MyTale (1.5.0). Posicion en espejo del espacio Z (1.5.20).
// Gemelo de Hunger.ui: misma anatomia y misma mascara, solo cambian los
// colores y los selectores. El porque de la caja de 100, del orden de capas
// y de la raiz centrada esta explicado en Hunger.ui.

@EasyWaterRuneMask = "RuneMask.png";

Group #EasyWaterRoot {
    Anchor: (Width: 1062, Height: 100, Bottom: 25);

    Group #EasyWaterContainer {
        Anchor: (Left: 962, Top: 0, Width: 100, Height: 100);
        Background: "RuneBase.png";

        CircularProgressBar #EasyWaterPreviewBar {
            Anchor: (Width: 100, Height: 100);
            MaskTexturePath: @EasyWaterRuneMask;
            Color: #2B4E8C;
            Value: 0;
            Visible: true;
        }

        CircularProgressBar #EasyWaterThirstBar {
            Anchor: (Width: 100, Height: 100);
            MaskTexturePath: @EasyWaterRuneMask;
            Color: #5FA8FF;
            Visible: true;
        }

        CircularProgressBar #EasyWaterCreativeThirstBar {
            Anchor: (Width: 100, Height: 100);
            MaskTexturePath: @EasyWaterRuneMask;
            Color: #7FD4E5;
            Visible: false;
        }

        Group #EasyWaterIcon {
            Anchor: (Width: 24, Height: 24, Left: 38, Top: 38);
            Background: "WaterIcon.png";
        }
    }
}
